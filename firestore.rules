rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      // Anyone can view leaderboard scores. Only the authenticated owner can
      // create, update, or delete their own anonymous-player entry.
      allow read: if true;
      allow create: if isValidScore(userId);
      allow update: if isValidScore(userId)
        && request.resource.data.score >= resource.data.score;
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && resource.data.uid == userId;

      function isValidScore(uid) {
        return request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'score', 'updatedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 20
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 1000000
          && request.resource.data.updatedAt == request.time;
      }
    }
  }
}
