rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      // Anyone can view the public leaderboard. Only the authenticated owner
      // can create or improve their own anonymous-player entry.
      allow read: if true;
      allow create: if isValidScore(userId)
        && request.resource.data.score >= 0;
      allow update: if isValidScore(userId)
        && request.resource.data.score >= resource.data.score;
      allow delete: if false;

      function isValidScore(uid) {
        return request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'score', 'updatedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 30
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 1000000
          && request.resource.data.updatedAt == request.time;
      }
    }
  }
}
